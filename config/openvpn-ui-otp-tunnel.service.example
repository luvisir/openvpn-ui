[Unit]
Description=OpenVPN OTP reverse forwarding initiated on vpn-1
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Install on vpn-1; uses root's default SSH identity/config, not an interactive agent.
# If the existing key only lives in an agent, configure an explicit IdentityFile first.
ExecStart=/usr/bin/ssh -NT -o BatchMode=yes -o StrictHostKeyChecking=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=15 -o ServerAliveCountMax=3 -R 127.0.0.1:18001:127.0.0.1:8001 root@192.168.0.77
Restart=always
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
