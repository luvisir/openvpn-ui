[Unit]
Description=OpenVPN OTP forwarding from vpn-2 to vpn-1
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Replace both placeholders and verify vpn-1's SSH host fingerprint first.
ExecStart=/usr/bin/ssh -NT -o BatchMode=yes -o StrictHostKeyChecking=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=15 -o ServerAliveCountMax=3 -i /path/to/otp-tunnel-key -L 127.0.0.1:18001:127.0.0.1:8001 root@VPN1_INTERNAL_IP
Restart=always
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
